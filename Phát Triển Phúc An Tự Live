-700/40 flex items-center justify-between text-xs\"\u003e\n        \u003cdiv className\u003d\"flex items-center gap-2\"\u003e\n          \u003cspan className\u003d\"text-slate-400\"\u003eKhung hình:\u003c/span\u003e\n          \u003cbutton\n            onClick\u003d{() \u003d\u003e setAspectRatio(\u002716:9\u0027)}\n            className\u003d{`px-2 py-1 rounded font-medium ${aspectRatio \u003d\u003d\u003d \u002716:9\u0027 ? \u0027bg-amber-500 text-slate-950\u0027 : \u0027bg-slate-700 text-slate-300\u0027}`}\n          \u003e\n            16:9 (Ngang)\n          \u003c/button\u003e\n          \u003cbutton\n            onClick\u003d{() \u003d\u003e setAspectRatio(\u00279:16\u0027)}\n            className\u003d{`px-2 py-1 rounded font-medium ${aspectRatio \u003d\u003d\u003d \u00279:16\u0027 ? \u0027bg-amber-500 text-slate-950\u0027 : \u0027bg-slate-700 text-slate-300\u0027}`}\n          \u003e\n            9:16 (Dọc TikTok)\n          \u003c/button\u003e\n        \u003c/div\u003e\n        \u003cbutton\n          onClick\u003d{() \u003d\u003e setLowPerformance(!lowPerformance)}\n          className\u003d{`px-2 py-1 rounded text-[11px] font-semibold ${lowPerformance ? \u0027bg-emerald-600/30 text-emerald-300 border border-emerald-500/50\u0027 : \u0027bg-slate-700 text-slate-300\u0027}`}\n        \u003e\n          {lowPerformance ? \u0027✓ Chế Độ X260 (Tiết Kiệm)\u0027 : \u0027Đồ Họa Cao\u0027}\n        \u003c/button\u003e\n      \u003c/div\u003e\n\n      {/* Navigation Tab Bar */}\n      \u003cdiv className\u003d\"flex overflow-x-auto p-1.5 gap-1 border-b border-slate-800 bg-slate-950/20 scrollbar-none\"\u003e\n        {tabs.map((tab) \u003d\u003e {\n          const Icon \u003d tab.icon;\n          const isActive \u003d activeTab \u003d\u003d\u003d tab.id;\n          return (\n            \u003cbutton\n              key\u003d{tab.id}\n              onClick\u003d{() \u003d\u003e setActiveTab(tab.id)}\n              className\u003d{`flex items-center gap-1.5 px-3 py-1.5 r