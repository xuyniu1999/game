ef \u003d useRef\u003cTHREE.Group\u003e(null);\n  const rightArmRef \u003d useRef\u003cTHREE.Group\u003e(null);\n  const leftLegRef \u003d useRef\u003cTHREE.Group\u003e(null);\n  const rightLegRef \u003d useRef\u003cTHREE.Group\u003e(null);\n\n  useFrame((state) \u003d\u003e {\n    const t \u003d state.clock.getElapsedTime();\n\n    if (!spineRef.current || !leftArmRef.current || !rightArmRef.current || !leftLegRef.current || !rightLegRef.current) {\n      return;\n    }\n\n    switch (action) {\n      case \u0027WALK\u0027: {\n        // Đi bộ nhẹ nhàng quanh sân chùa\n        const legSwing \u003d Math.sin(t * 4) * 0.45;\n        leftLegRef.current.rotation.x \u003d legSwing;\n        rightLegRef.current.rotation.x \u003d -legSwing;\n        leftArmRef.current.rotation.x \u003d -legSwing * 0.6;\n        rightArmRef.current.rotation.x \u003d legSwing * 0.6;\n        spineRef.current.position.y \u003d 0.8 + Math.abs(Math.sin(t * 8)) * 0.05;\n        spineRef.current.rotation.x \u003d 0.05;\n        break;\n      }\n\n      case \u0027PRAY_HANDS\u0027: {\n        // Chắp tay búp sen trước ngực\n        leftLegRef.current.rotation.x \u003d 0;\n        rightLegRef.current.rotation.x \u003d 0;\n        spineRef.current.position.y \u003d 0.8;\n        spineRef.current.rotation.x \u003d 0;\n\n        leftArmRef.current.rotation.set(-1.1, 0.4, -0.3);\n        rightArmRef.current.rotation.set(-1.1, -0.4, 0.3);\n        // Hít thở nhẹ nhàng\n        if (headRef.current) {\n          headRef.current.rotation.x \u003d 0.15 + Math.sin(t * 2) * 0.03;\n        }\n        break;\n      }\n\n      case \u0027BOW\u0027: {\n        // Cúi đầu cung kính\n        leftLegRef.current.rotation.x \u003d 0;\n        rightLegRef.current.rotation.x \u003d 0;\n        spineRef.current.position.y \u003d 0.8;\n        spineRef.current.rotation.x \u003d 0.55 + Math.sin(t * 2) * 0.05; // Gập lưng\n        leftArmRef.current.rotation.set(-1.0, 0.3, -0.2);\n        rightArmRef.current.rotation.set(-1.0, -0.3, 0.2);\n        if (headRef.current) headRef.current.rotation.x \u003d 0.3;\n        break;\n      }\n\n      case \u0027KNEEL\u0027: {\n        // Quỳ gối trang nghiêm\n        spineRef.current.position.y \u003d 0.42;\n        leftLegRef.current.rotation.x \u003d -Math.PI / 2.2;\n        rightLegRef.current.rotation.x \u003d -Math.PI / 2.2;\n        leftArmRef.current.rotation.set(-0.8, 0.3, 0);\n        rightArmRef.current.rotation.set(-0.8, -0.3, 0);\n        spineRef.current.rotation.x \u003d 0.05;\n        break;\n      }\n\n      case \u0027PROSTRATE\u0027: {\n        // Cúi lạy sát đất ngũ thể đầu địa (Đỉnh lễ)\n        const bowAnim \u003d (Math.sin(t * 1.8) + 1) / 2; // Chu kỳ lạy từ 0 đến 1\n        spineRef.current.position.y \u003d 0.45 - bowAnim * 0.25;\n        spineRef.current.rotation.x \u003d 0.2 + bowAnim * 1.1; // Cúi gập sát sàn\n        leftLegRef.current.rotation.x \u003d -Math.PI / 2;\n        rightLegRef.current.rotation.x \u003d -Math.PI / 2;\n        leftArmRef.current.rotation.set(-0.5 - bowAnim * 0.9, 0.2, 0);\n        rightArmRef.current.rotation.set(-0.5 - bowAnim * 0.9, -0.2, 0);\n        if (headRef.current) headRef.current.rotation.x \u003d bowAnim * 0.4;\n        break;\n      }\n\n      case \u0027MEDITATE\u0027: {\n        // Ngồi kiết già tĩnh tọa\n        spineRef.current.position.y \u003d 0.35;\n        spineRef.current.rotation.x \u003d 0;\n        leftLegRef.current.rotation.set(-Math.PI / 2.1, 0.3, 0.3);\n        rightLegRef.current.rotation.set(-Math.PI / 2.1, -0.3, -0.3);\n        leftArmRef.current.rotation.set(-0.6, 0.3, 0.2);\n        rightArmRef.current.rotation.set(-0.6, -0.3, -0.2);\n        if (headRef.current) headRef.current.rotation.x \u003d 0.08;\n        break;\n      }\n\n      case \u0027STAND\u0027:\n      default: {\n        // Đứng buông thư\n        spineRef.current.position.y \u003d 0.8;\n        spineRef.current.rotation.x \u003d 0;\n        leftLegRef.current.rotation.x \u003d 0;\n        rightLegRef.current.rotation.x \u003d 0;\n        leftArmRef.current.rotation.set(0.05, 0, -0.05);\n        rightArmRef.current.rotation.set(0.05, 0, 0.05);\n        if (headRef.current) headRef.current.rotation.x \u003d 0;\n        break;\n      }\n    }\n  });\n\n  return (\n    \u003cgroup ref\u003d{rootRef} position\u003d{position} rotation\u003d{[0, rotationY, 0]}\u003e\n      {/* Tên hiển thị trên đầu Phật tử */}\n      \u003cmesh position\u003d{[0, 2.2, 0]}\u003e\n        {/* Nhãn đơn giản tối ưu cấu hình */}\n      \u003c/mesh\u003e\n\n      {/* Cụm Chân Trái \u0026 Phải */}\n      \u003cgroup position\u003d{[-0.18, 0.75, 0]} ref\u003d{leftLegRef}\u003e\n        \u003cmesh position\u003d{[0, -0.38, 0]}\u003e\n          \u003ccylinderGeometry args\u003d{[0.09, 0.08, 0.75, 8]} /\u003e\n          \u003cmeshStandardMaterial color\u003d\"#2d3748\" /\u003e\n        \u003c/mesh\u003e\n      \u003c/group\u003e\n      \u003cgroup position\u003d{[0.18, 0.75, 0]} ref\u003d{rightLegRef}\u003e\n        \u003cmesh position\u003d{[0, -0.38, 0]}\u003e\n          \u003ccylinderGeometry args\u003d{[0.09, 0.08, 0.75, 8]} /\u003e\n          \u003cmeshStandardMaterial color\u003d\"#2d3748\" /\u003e\n        \u003c/mesh\u003e\n      \u003c/group\u003e\n\n      {/* Cụm Cột Sống \u0026 Thân Áo Tràng / Áo Cà Sa */}\n      \u003cgroup position\u003d{[0, 0.8, 0]} ref\u003d{spineRef}\u003e\n        {/* Thân mình */}\n        \u003cmesh position\u003d{[0, 0.45, 0]}\u003e\n          \u003ccylinderGeometry args\u003d{[0.26, 0.32, 0.85, 10]} /\u003e\n          \u003cmeshStandardMaterial color\u003d{color} roughness\u003d{0.7} /\u003e\n        \u003c/mesh\u003e\n\n        {/* Cánh tay trái */}\n        \u003cgroup position\u003d{[-0.35, 0.75, 0]} ref\u003d{leftArmRef}\u003e\n          \u003cmesh position\u003d{[0, -0.28, 0]}\u003e\n            \u003ccylinderGeometry args\u003d{[0.07, 0.06, 0.6, 8]} /\u003e\n            \u003cmeshStandardMaterial color\u003d{color} /\u003e\n          \u003c/mesh\u003e\n          \u003cmesh position\u003d{[0, -0.6, 0]}\u003e\n            \u003csphereGeometry args\u003d{[0.07, 8, 8]} /\u003e\n            \u003cmeshStandardMaterial color\u003d\"#fed7aa\" /\u003e\n          \u003c/mesh\u003e\n        \u003c/group\u003e\n\n        {/* Cánh tay phải */}\n        \u003cgroup position\u003d{[0.35, 0.75, 0]} ref\u003d{rightArmRef}\u003e\n          \u003cmesh position\u003d{[0, -0.28, 0]}\u003e\n            \u003ccylinderGeometry args\u003d{[0.07, 0.06, 0.6, 8]} /\u003e\n            \u003cmeshStandardMaterial color\u003d{color} /\u003e\n          \u003c/mesh\u003e\n          \u003cmesh position\u003d{[0, -0.6, 0]}\u003e\n            \u003csphereGeometry args\u003d{[0.07, 8, 8]} /\u003e\n            \u003cmeshStandardMaterial color\u003d\"#fed7aa\" /\u003e\n          \u003c/mesh\u003e\n        \u003c/group\u003e\n\n        {/* Đầu \u0026 Khuôn mặt */}\n        \u003cgroup position\u003d{[0, 1.05, 0]} ref\u003d{headRef}\u003e\n          \u003cmesh\u003e\n            \u003csphereGeometry args\u003d{[0.2, 12, 12]} /\u003e\n            \u003cmeshStandardMaterial color\u003d\"#fed7aa\" roughness\u003d{0.5} /\u003e\n          \u003c/mesh\u003e\n        \u003c/group\u003e\n      \u003c/group\u003e\n    \u003c/group\u003e\n  );\n};\n```\n\n---\n\n### BƯỚC 6: HIỆU ỨNG ÁNH SÁNG \u0026 HOA SEN NỞ (EFFECTS)\n\n#### `src/components/scene/EffectsLayer.tsx`\n```typescript\nimport React, { useRef } from \u0027react\u0027;\nimport { useFrame } from \u0027@react-three/fiber\u0027;\nimport * as THREE from \u0027three\u0027;\nimport { useLive } from \u0027../../context/LiveContext\u0027;\n\nexport const EffectsLayer: React.FC \u003d () \u003d\u003e {\n  const { activeEffect } \u003d useLive();\n  const flowerRef \u003d useRef\u003cTHREE.Group\u003e(null);\n  const heartGroupRef \u003d useRef\u003cTHREE.Group\u003e(null);\n\n  useFrame((state) \u003d\u003e {\n    const t \u003d state.clock.getElapsedTime();\n\n    if (flowerRef.current) {\n      flowerRef.current.rotation.y \u003d t * 1.5;\n      const s \u003d Math.min(1.6, 0.4 + (Math.sin(t * 3) + 1) * 0.6);\n      flowerRef.current.scale.set(s, s, s);\n    }\n\n    if (heartGroupRef.current) {\n      heartGroupRef.current.position.y \u003d 2.5 + Math.sin(t * 3) * 0.4;\n      heartGroupRef.current.rotation.y \u003d t * 2;\n    }\n  });\n\n  if (!activeEffect) return null;\n\n  return (\n    \u003cgroup position\u003d{[0, 2, -2]}\u003e\n      {activeEffect \u003d\u003d\u003d \u0027ROSE\u0027 \u0026\u0026 (\n        \u003cgroup ref\u003d{flowerRef}\u003e\n          {/* Đại đóa hoa sen nở rộ giữa không trung */}\n          \u003cpointLight color\u003d\"#f472b6\" intensity\u003d{3} distance\u003d{6} /\u003e\n          {[0, 1, 2, 3, 4, 5].map((i) \u003d\u003e (\n            \u003cmesh\n              key\u003d{i}\n              rotation\u003d{[0.4, (i * Math.PI) / 3, 0]}\n              position\u003d{[Math.sin((i * Math.PI) / 3) * 0.4, 0, Math.cos((i * Math.PI) / 3) * 0.4]}\n            \u003e\n              \u003cconeGeometry args\u003d{[0.3, 0.8, 6]} /\u003e\n              \u003cmeshStandardMaterial color\u003d\"#f43f5e\" emissive\u003d\"#be123c\" emissiveIntensity\u003d{0.5} /\u003e\n            \u003c/mesh\u003e\n          ))}\n        \u003c/group\u003e\n      )}\n\n      {activeEffect \u003d\u003d\u003d \u0027HEART\u0027 \u0026\u0026 (\n        \u003cgroup ref\u003d{heartGroupRef}\u003e\n          {/* Quầng sáng quang minh */}\n          \u003cpointLight color\u003d\"#fbbf24\" intensity\u003d{4} distance\u003d{8} /\u003e\n          \u003cmesh\u003e\n            \u003coctahedronGeometry args\u003d{[0.9, 0]} /\u003e\n            \u003cmeshStandardMaterial color\u003d\"#fbbf24\" emissive\u003d\"#d97706\" emissiveIntensity\u003d{0.8} /\u003e\n          \u003c/mesh\u003e\n        \u003c/group\u003e\n      )}\n\n      {activeEffect \u003d\u003d\u003d \u0027LOTUS\u0027 \u0026\u0026 (\n        \u003cgroup\u003e\n          \u003cpointLight color\u003d\"#38bdf8\" intensity\u003d{3} distance\u003d{7} /\u003e\n          \u003cmesh position\u003d{[0, 0.5, 0]}\u003e\n            \u003ctorusGeometry args\u003d{[1.2, 0.15, 8, 24]} /\u003e\n            \u003cmeshStandardMaterial color\u003d\"#38bdf8\" emissive\u003d\"#0284c7\" emissiveIntensity\u003d{0.9} /\u003e\n          \u003c/mesh\u003e\n        \u003c/group\u003e\n      )}\n    \u003c/group\u003e\n  );\n};\n```\n\n---\n\n### BƯỚC 7: CAMERA \u0026 BỘ DỰNG CHÍNH (TEMPLE SCENE)\n\n#### `src/components/scene/TempleScene.tsx`\n```typescript\nimport React, { useEffect, useRef } from \u0027react\u0027;\nimport { Canvas, useFrame, useThree } from \u0027@react-three/fiber\u0027;\nimport { OrbitControls } from \u0027@react-three/drei\u0027;\nimport * as THREE from \u0027three\u0027;\nimport { useLive } from \u0027../../context/LiveContext\u0027;\nimport { VietnameseTemple } from \u0027./Architecture\u0027;\nimport { LotusPond } from \u0027./LotusPond\u0027;\nimport { CharacterModel } from \u0027./CharacterModel\u0027;\nimport { EffectsLayer } from \u0027./EffectsLayer\u0027;\n\n// Bộ điều phối chuyển góc Camera mượt mà\nconst CameraController: React.FC \u003d () \u003d\u003e {\n  const { cameraPreset, setFps } \u003d useLive();\n  const { camera } \u003d useThree();\n  const frameCount \u003d useRef(0);\n  const lastTime \u003d useRef(performance.now());\n\n  useFrame(() \u003d\u003e {\n    // Đo đếm FPS thực tế trên ThinkPad X260\n    frameCount.current++;\n    const now \u003d performance.now();\n    if (now - lastTime.current \u003e\u003d 1000) {\n      setFps(Math.round((frameCount.current * 1000) / (now - lastTime.current)));\n      frameCount.current \u003d 0;\n      lastTime.current \u003d now;\n    }\n  });\n\n  useEffect(() \u003d\u003e {\n    const targets: Record\u003cstring, { pos: [number, number, number]; look: [number, number, number] }\u003e \u003d {\n      OVERVIEW: { pos: [0, 8, 16], look: [0, 2, -2] },\n      SAN_CHUA: { pos: [0, 3, 5], look: [0, 2, -6] },\n      CHINH_DIEN: { pos: [0, 2.8, -3], look: [0, 3, -8] },\n      HO_SEN: { pos: [-8, 3.5, 9], look: [-9, 0.5, 4] }\n    };\n\n    const target \u003d targets[cameraPreset] || targets.OVERVIEW;\n    camera.position.set(...target.pos);\n    camera.lookAt(...target.look);\n  }, [cameraPreset, camera]);\n\n  return null;\n};\n\nexport const TempleCanvas: React.FC \u003d () \u003d\u003e {\n  const { lowPerformance, characters } \u003d useLive();\n\n  return (\n    \u003cdiv className\u003d\"w-full h-full relative select-none\"\u003e\n      \u003cCanvas\n        shadows\u003d{!lowPerformance}\n        gl\u003d{{\n          antialias: !lowPerformance,\n          powerPreference: \u0027high-performance\u0027,\n          toneMapping: THREE.ACESFilmicToneMapping,\n          toneMappingExposure: 1.1\n        }}\n        dpr\u003d{lowPerformance ? 1 : [1, 1.5]}\n        camera\u003d{{ position: [0, 7, 15], fov: 48 }}\n      \u003e\n        \u003cCameraController /\u003e\n        \u003cOrbitControls\n          maxPolarAngle\u003d{Math.PI / 2 - 0.05}\n          minDistance\u003d{2}\n          maxDistance\u003d{35}\n          target\u003d{[0, 1.5, -2]}\n        /\u003e\n\n        {/* Ánh sáng trời thanh tịnh */}\n        \u003cambientLight intensity\u003d{lowPerformance ? 1.0 : 0.6} /\u003e\n        \u003cdirectionalLight\n          position\u003d{[10, 16, 8]}\n          intensity\u003d{1.2}\n          castShadow\u003d{!lowPerformance}\n          shadow-mapSize-width\u003d{512}\n          shadow-mapSize-height\u003d{512}\n        /\u003e\n\n        {/* Không gian chùa */}\n        \u003cVietnameseTemple /\u003e\n        \u003cLotusPond /\u003e\n\n        {/* Danh sách nhân vật hoạt ảnh */}\n        {characters.map((char) \u003d\u003e (\n          \u003cCharacterModel\n            key\u003d{char.id}\n            name\u003d{char.name}\n            action\u003d{char.action}\n            position\u003d{char.position}\n            rotationY\u003d{char.rotationY}\n            color\u003d{char.color}\n          /\u003e\n        ))}\n\n        {/* Lớp hiệu ứng dâng hoa / hào quang */}\n        \u003cEffectsLayer /\u003e\n      \u003c/Canvas\u003e\n    \u003c/div\u003e\n  );\n};\n```\n\n---\n\n### BƯỚC 8: BẢNG ĐIỀU KHIỂN ĐA NĂNG (DASHBOARD TỔNG LỰC)\n\n#### `src/components/dashboard/Dashboard.tsx`\n```typescript\nimport React, { useState } from \u0027react\u0027;\nimport { useLive } from \u0027../../context/LiveContext\u0027;\nimport { \n  Building2, \n  Users, \n  Gift, \n  Radio, \n  Volume2, \n  FileText, \n  Sliders, \n  Sparkles,\n  Maximize2,\n  Tv\n} from \u0027lucide-react\u0027;\nimport { ControlPanel } from \u0027./ControlPanel\u0027;\nimport { CharacterPanel } from \u0027./CharacterPanel\u0027;\nimport { GiftConfigPanel } from \u0027./GiftConfigPanel\u0027;\nimport { TikTokPanel } from \u0027./TikTokPanel\u0027;\nimport { LogPanel } from \u0027./LogPanel\u0027;\n\nexport const Dashboard: React.FC \u003d () \u003d\u003e {\n  const [activeTab, setActiveTab] \u003d useState\u003cstring\u003e(\u0027scene\u0027);\n  const { \n    cleanMode, \n    setCleanMode, \n    aspectRatio, \n    setAspectRatio, \n    fps, \n    lowPerformance, \n    setLowPerformance \n  } \u003d useLive();\n\n  if (cleanMode) {\n    return (\n      \u003cbutton\n        onClick\u003d{() \u003d\u003e setCleanMode(false)}\n        className\u003d\"absolute top-4 right-4 z-50 bg-black/60 hover:bg-black/90 text-white px-3 py-1.5 rounded-lg text-sm flex items-center gap-2 border border-white/20 backdrop-blur-md shadow-lg\"\n      \u003e\n        \u003cTv size\u003d{16} /\u003e Mở Lại Bảng Điều Khiển (Thoát Clean Mode)\n      \u003c/button\u003e\n    );\n  }\n\n  const tabs \u003d [\n    { id: \u0027scene\u0027, label: \u0027Cảnh Chùa\u0027, icon: Building2 },\n    { id: \u0027characters\u0027, label: \u0027Nhân Vật (3D)\u0027, icon: Users },\n    { id: \u0027gifts\u0027, label: \u0027Quà \u0026 Demo\u0027, icon: Gift },\n    { id: \u0027effects\u0027, label: \u0027Hiệu Ứng\u0027, icon: Spark