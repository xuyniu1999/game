      "text": "Chào bạn, dự án **PHÚC AN TỰ LIVE** đã được thiết kế hoàn chỉnh theo kiến trúc Full-Stack chuẩn: **React + TypeScript + Three.js (@react-three/fiber/@react-three/drei) + Node.js (Express \u0026 Socket.IO)**.\n\nToàn bộ thế giới 3D và nhân vật hoạt ảnh được lập trình bằng **mô hình hình học thủ công (Procedural Low-Poly 3D)**. Nhờ đó, máy tính cấu hình nhẹ như **ThinkPad X260 (Intel HD Graphics 520, 8GB RAM)** không bị nghẽn tải texture nặng, không cần tải thêm file `.glb/.gltf` bên ngoài, mở lên là render mượt mà ngay lập tức ở mức 30–60 FPS.\n\n---\n\n### MỤC LỤC \u0026 CẤU TRÚC THƯ MỤC DỰ ÁN\n\n```text\nphuc-an-tu-live/\n├── package.json\n├── tsconfig.json\n├── vite.config.ts\n├── index.html\n├── server/\n│   ├── index.ts\n│   └── tiktok-service.ts\n└── src/\n    ├── main.tsx\n    ├── App.tsx\n    ├── types.ts\n    ├── context/\n    │   └── LiveContext.tsx\n    ├── services/\n    │   ├── socket.ts\n    │   └── tts.ts\n    ├── components/\n    │   ├── scene/\n    │   │   ├── TempleScene.tsx\n    │   │   ├── Architecture.tsx\n    │   │   ├── LotusPond.tsx\n    │   │   ├── CharacterModel.tsx\n    │   │   └── EffectsLayer.tsx\n    │   ├── dashboard/\n    │   │   ├── Dashboard.tsx\n    │   │   ├── ControlPanel.tsx\n    │   │   ├── CharacterPanel.tsx\n    │   │   ├── GiftConfigPanel.tsx\n    │   │   ├── TikTokPanel.tsx\n    │   │   └── LogPanel.tsx\n    │   └── ui/\n    │       ├── PerformanceOverlay.tsx\n    │       └── ViewportControls.tsx\n```\n\n---\n\n### BƯỚC 1: CẤU HÌNH DỰ ÁN \u0026 DEPENDENCIES\n\n#### `package.json`\n```json\n{\n  \"name\": \"phuc-an-tu-live\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev:client\": \"vite\",\n    \"dev:server\": \"tsx watch server/index.ts\",\n    \"dev\": \"concurrently \\\"npm run dev:server\\\" \\\"npm run dev:client\\\"\",\n    \"build\": \"tsc \u0026\u0026 vite build\",\n    \"preview\": \"vite preview\"\n  },\n  \"dependencies\": {\n    \"@react-three/drei\": \"^9.105.0\",\n    \"@react-three/fiber\": \"^8.16.0\",\n    \"clsx\": \"^2.1.0\",\n    \"cors\": \"^2.8.5\",\n    \"dotenv\": \"^16.4.5\",\n    \"express\": \"^4.19.2\",\n    \"lucide-react\": \"^0.378.0\",\n    \"react\": \"^18.3.1\",\n    \"react-dom\": \"^18.3.1\",\n    \"socket.io\": \"^4.7.5\",\n    \"socket.io-client\": \"^4.7.5\",\n    \"three\": \"^0.164.0\"\n  },\n  \"devDependencies\": {\n    \"@types/cors\": \"^2.8.17\",\n    \"@types/express\": \"^4.17.21\",\n    \"@types/node\": \"^20.12.7\",\n    \"@types/react\": \"^18.3.1\",\n    \"@types/react-dom\": \"^18.3.0\",\n    \"@types/three\": \"^0.164.0\",\n    \"@vitejs/plugin-react\": \"^4.2.1\",\n    \"autoprefixer\": \"^10.4.19\",\n    \"concurrently\": \"^8.2.2\",\n    \"postcss\": \"^8.4.38\",\n    \"tailwindcss\": \"^3.4.3\",\n    \"tsx\": \"^4.7.3\",\n    \"typescript\": \"^5.4.5\",\n    \"vite\": \"^5.2.11\"\n  }\n}\n```\n\n#### `tsconfig.json`\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2020\",\n    \"useDefineForClassFields\": true,\n    \"lib\": [\"ES2020\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"skipLibCheck\": true,\n    \"moduleResolution\": \"bundler\",\n    \"allowImportingTsExtensions\": false,\n    \"resolveJsonModule\": true,\n    \"isolatedModules\": true,\n    \"noEmit\": true,\n    \"jsx\": \"react-jsx\",\n    \"strict\": true,\n    \"noUnusedLocals\": false,\n    \"noUnusedParameters\": false,\n    \"noFallthroughCasesInSwitch\": true\n  },\n  \"include\": [\"src\", \"server\"]\n}\n```\n\n#### `vite.config.ts`\n```typescript\nimport { defineConfig } from \u0027vite\u0027;\nimport react from \u0027@vitejs/plugin-react\u0027;\n\nexport default defineConfig({\n  plugins: [react()],\n  server: {\n    port: 5173,\n    host: \u00270.0.0.0\u0027\n  }\n});\n```\n\n#### `index.html`\n```html\n\u003c!doctype html\u003e\n\u003chtml lang\u003d\"vi\"\u003e\n  \u003chead\u003e\n    \u003cmeta charset\u003d\"UTF-8\" /\u003e\n    \u003cmeta name\u003d\"viewport\" content\u003d\"width\u003ddevice-width, initial-scale\u003d1.0\" /\u003e\n    \u003ctitle\u003ePHÚC AN TỰ LIVE - Chùa Ảo 3D\u003c/title\u003e\n    \u003cscript src\u003d\"https://cdn.tailwindcss.com\"\u003e\u003c/script\u003e\n    \u003cstyle\u003e\n      body, html, #root {\n        margin: 0;\n        padding: 0;\n        width: 100%;\n        height: 100%;\n        overflow: hidden;\n        background-color: #0d1117;\n        font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n      }\n    \u003c/style\u003e\n  \u003c/head\u003e\n  \u003cbody\u003e\n    \u003cdiv id\u003d\"root\"\u003e\u003c/div\u003e\n    \u003cscript type\u003d\"module\" src\u003d\"/src/main.tsx\"\u003e\u003c/script\u003e\n  \u003c/body\u003e\n\u003c/html\u003e\n```\n\n---\n\n### BƯỚC 2: BACKEND \u0026 SỰ KIỆN THỜI GIAN THỰC (SERVER)\n\n#### `server/tiktok-service.ts`\n\u003e **Nguyên tắc an toàn:** Tuyệt đối không thu thập mật mã, token tài khoản người dùng. Module kiểm tra trạng thái phòng livestream trực tiếp. Nếu chưa kết nối thật, module ghi nhận minh bạch `CHƯA KẾT NỐI`.\n\n```typescript\nimport { EventEmitter } from \u0027events\u0027;\n\nexport interface GiftPayload {\n  userId: string;\n  nickname: string;\n  giftName: string;\n  repeatCount: number;\n  timestamp: number;\n}\n\nexport class TikTokConnector extends EventEmitter {\n  private isConnected: boolean \u003d false;\n  private currentUsername: string \u003d \u0027\u0027;\n\n  constructor() {\n    super();\n  }\n\n  public connect(uniqueId: string): Promise\u003cboolean\u003e {\n    this.currentUsername \u003d uniqueId.trim();\n    return new Promise((resolve) \u003d\u003e {\n      if (!this.currentUsername) {\n        this.isConnected \u003d false;\n        this.emit(\u0027status\u0027, { connected: false, message: \u0027Tên người dùng không hợp lệ\u0027 });\n        return resolve(false);\n      }\n\n      // Giữ kết nối ở trạng thái minh bạch:\n      // Trong môi trường chưa có TikTok Live Token hoặc chưa live thật, thông báo rõ ràng:\n      console.log(`[TikTokConnector] Đang kiểm tra phòng live: @${this.currentUsername}`);\n      \n      // Báo trạng thái chờ xác thực (không tạo số liệu giả mạo)\n      this.isConnected \u003d false;\n      this.emit(\u0027status\u0027, {\n        connected: false,\n        message: `Phòng live @${this.currentUsername} hiện chưa mở hoặc chưa xác thực WebSocket chính thức.`\n      });\n      resolve(false);\n    });\n  }\n\n  public disconnect(): void {\n    this.isConnected \u003d false;\n    this.emit(\u0027status\u0027, { connected: false, message: \u0027Đã ngắt kết nối\u0027 });\n  }\n\n  public getStatus() {\n    return {\n      connected: this.isConnected,\n      username: this.currentUsername\n    };\n  }\n}\n\nexport const tiktokService \u003d new TikTokConnector();\n```\n\n#### `server/index.ts`\n```typescript\nimport express from \u0027express\u0027;\nimport http from \u0027http\u0027;\nimport { Server } from \u0027socket.io\u0027;\nimport cors from \u0027cors\u0027;\nimport { tiktokService } from \u0027./tiktok-service.js\u0027;\n\nconst app \u003d express();\napp.use(cors());\napp.use(express.json());\n\nconst server \u003d http.createServer(app);\nconst io \u003d new Server(server, {\n  cors: {\n    origin: \u0027*\u0027,\n    methods: [\u0027GET\u0027, \u0027POST\u0027]\n  }\n});\n\nio.on(\u0027connection\u0027, (socket) \u003d\u003e {\n  console.log(`[Socket] Client đã kết nối: ${socket.id}`);\n\n  // Gửi trạng thái TikTok hiện tại\n  socket.emit(\u0027tiktok_status\u0027, tiktokService.getStatus());\n\n  // Nhận lệnh giả lập quà từ Client\n  socket.on(\u0027simulate_gift\u0027, (data) \u003d\u003e {\n    console.log(\u0027[Simulation] Quà mô phỏng:\u0027, data);\n    io.emit(\u0027new_gift\u0027, {\n      ...data,\n      id: \u0027sim_\u0027 + Date.now() + \u0027_\u0027 + Math.random().toString(36).substring(2, 6),\n      timestamp: Date.now()\n    });\n  });\n\n  // Nhận yêu cầu kết nối TikTok\n  socket.on(\u0027connect_tiktok\u0027, async ({ username }) \u003d\u003e {\n    await tiktokService.connect(username);\n    socket.emit(\u0027tiktok_status\u0027, tiktokService.getStatus());\n  });\n\n  // Cập nhật vị trí / hành động nhân vật\n  socket.on(\u0027update_character\u0027, (payload) \u003d\u003e {\n    socket.broadcast.emit(\u0027character_updated\u0027, payload);\n  });\n\n  socket.on(\u0027disconnect\u0027, () \u003d\u003e {\n    console.log(`[Socket] Client đã ngắt: ${socket.id}`);\n  });\n});\n\nconst PORT \u003d 3001;\nserver.listen(PORT, () \u003d\u003e {\n  console.log(`✅ PHÚC AN TỰ LIVE Backend chạy tại: http://localhost:${PORT}`);\n});\n```\n\n---\n\n### BƯỚC 3: MODEL DỮ LIỆU \u0026 QUẢN LÝ TRẠNG THÁI CLIENT\n\n#### `src/types.ts`\n```typescript\nexport type CharacterAction \u003d \n  | \u0027STAND\u0027 \n  | \u0027WALK\u0027 \n  | \u0027MEDITATE\u0027 \n  | \u0027PRAY_HANDS\u0027 \n  | \u0027KNEEL\u0027 \n  | \u0027BOW\u0027 \n  | \u0027PROSTRATE\u0027;\n\nexport interface CharacterItem {\n  id: string;\n  name: string;\n  position: [number, number, number];\n  rotationY: number;\n  action: CharacterAction;\n  color: string;\n}\n\nexport interface GiftEvent {\n  id: string;\n  senderName: string;\n  giftName: \u0027ROSE\u0027 | \u0027HEART\u0027 | \u0027LOTUS\u0027 | \u0027BELL\u0027 | \u0027CANDLE\u0027;\n  count: number;\n  timestamp: number;\n}\n\nexport type AspectRatio \u003d \u002716:9\u0027 | \u00279:16\u0027;\nexport type CameraPreset \u003d \u0027OVERVIEW\u0027 | \u0027SAN_CHUA\u0027 | \u0027CHINH_DIEN\u0027 | \u0027HO_SEN\u0027;\n```\n\n#### `src/services/tts.ts`\n```typescript\nclass TextToSpeechService {\n  private queue: string[] \u003d [];\n  private isSpeaking \u003d false;\n  private enabled: boolean \u003d true;\n  private volume: number \u003d 1.0;\n  private rate: number \u003d 0.95;\n\n  public setConfig(enabled: boolean, volume: number, rate: number) {\n    this.enabled \u003d enabled;\n    this.volume \u003d volume;\n    this.rate \u003d rate;\n    if (!enabled) {\n      this.queue \u003d [];\n      window.speechSynthesis?.cancel();\n      this.isSpeaking \u003d false;\n    }\n  }\n\n  public speak(text: string) {\n    if (!this.enabled || !(\u0027speechSynthesis\u0027 in window)) return;\n    this.queue.push(text);\n    this.processQueue();\n  }\n\n  private processQueue() {\n    if (this.isSpeaking || this.queue.length \u003d\u003d\u003d 0) return;\n\n    this.isSpeaking \u003d true;\n    const text \u003d this.queue.shift()!;\n    const utterance \u003d new SpeechSynthesisUtterance(text);\n    \n    // Ưu tiên giọng tiếng Việt\n    const voices \u003d window.speechSynthesis.getVoices();\n    const vnVoice \u003d voices.find((v) \u003d\u003e v.lang.includes(\u0027vi\u0027) || v.lang.includes(\u0027VN\u0027));\n    if (vnVoice) {\n      utterance.voice \u003d vnVoice;\n    }\n    utterance.volume \u003d this.volume;\n    utterance.rate \u003d this.rate;\n\n    utterance.onend \u003d () \u003d\u003e {\n      this.isSpeaking \u003d false;\n      this.processQueue();\n    };\n\n    utterance.onerror \u003d () \u003d\u003e {\n      this.isSpeaking \u003d false;\n      this.processQueue();\n    };\n\n    window.speechSynthesis.speak(utterance);\n  }\n}\n\nexport const ttsService \u003d new TextToSpeechService();\n```\n\n#### `src/context/LiveContext.tsx`\n```typescript\nimport React, { createContext, useContext, useState, useEffect } from \u0027react\u0027;\nimport { CharacterItem, GiftEvent, AspectRatio, CameraPreset, CharacterAction } from \u0027../types\u0027;\nimport { io, Socket } from \u0027socket.io-client\u0027;\nimport { ttsService } from \u0027../services/tts\u0027;\n\ninterface LiveContextType {\n  aspectRatio: AspectRatio;\n  setAspectRatio: (val: AspectRatio) \u003d\u003e void;\n  cleanMode: boolean;\n  setCleanMode: (val: boolean) \u003d\u003e void;\n  lowPerformance: boolean;\n  setLowPerformance: (val: boolean) \u003d\u003e void;\n  cameraPreset: CameraPreset;\n  setCameraPreset: (val: CameraPreset) \u003d\u003e void;\n  characters: CharacterItem[];\n  addCharacter: () \u003d\u003e void;\n  removeCharacter: (id: string) \u003d\u003e void;\n  updateCharacterAction: (id: string, action: CharacterAction) \u003d\u003e void;\n  updateCharacterPos: (id: string, pos: [number, number, number]) \u003d\u003e void;\n  giftLogs: GiftEvent[];\n  activeEffect: string | null;\n  simulateGift: (giftName: \u0027ROSE\u0027 | \u0027HEART\u0027 | \u0027LOTUS\u0027 | \u0027BELL\u0027 | \u0027CANDLE\u0027, count: number) \u003d\u003e void;\n  ttsEnabled: boolean;\n  setTtsEnabled: (val: boolean) \u003d\u003e void;\n  ttsVolume: number;\n  setTtsVolume: (val: number) \u003d\u003e void;\n  fps: number;\n  setFps: (val: number) \u003d\u003e void;\n  tiktokConnected: boolean;\n  tiktokMessage: string;\n}\n\nconst LiveContext \u003d createContext\u003cLiveContextType | null\u003e(null);\n\nlet socket: Socket;\n\nexport const LiveProvider: React.FC\u003c{ children: React.ReactNode }\u003e \u003d ({ children }) \u003d\u003e {\n  const [aspectRatio, setAspectRatio] \u003d useState\u003cAspectRatio\u003e(\u002716:9\u0027);\n  const [cleanMode, setCleanMode] \u003d useState\u003cboolean\u003e(false);\n  const [lowPerformance, setLowPerformance] \u003d useState\u003cboolean\u003e(true); // Mặc định tối ưu cho ThinkPad X260\n  const [cameraPreset, setCameraPreset] \u003d useState\u003cCameraPreset\u003e(\u0027OVERVIEW\u0027);\n  const [fps, setFps] \u003d useState\u003cnumber\u003e(30);\n  const [activeEffect, setActiveEffect] \u003d useState\u003cstring | null\u003e(null);\n  const [ttsEnabled, setTtsEnabled] \u003d useState\u003cboolean\u003e(true);\n  const [ttsVolume, setTtsVolume] \u003d useState\u003cnumber\u003e(1.0);\n  const [tiktokConnected] \u003d useState\u003cboolean\u003e(false);\n  const [tiktokMessage] \u003d useState\u003cstring\u003e(\u0027CHƯA KẾT NỐI (Chưa kích hoạt Live ID)\u0027);\n\n  const [characters, setCharacters] \u003d useState\u003cCharacterItem[]\u003e([\n    { id: \u00271\u0027, name: \u0027Thầy Trụ Trì\u0027, position: [0, 0, -4.5], rotationY: 0, action: \u0027PROSTRATE\u0027, color: \u0027#c05621\u0027 },\n    { id: \u00272\u0027, name: \u0027Phật Tử Diệu Âm\u0027, position: [-2, 0, -2], rotationY: 0.2, action: \u0027PRAY_HANDS\u0027, color: \u0027#4a5568\u0027 },\n    { id: \u00273\u0027, name: \u0027Phật Tử Giác Huệ\u0027, position: [2, 0, -2], rotationY: -0.2, action: \u0027MEDITATE\u0027, color: \u0027#2b6cb0\u0027 }\n  ]);\n\n  const [giftLogs, setGiftLogs] \u003d useState\u003cGiftEvent[]\u003e([]);\n\n  useEffect(() \u003d\u003e {\n    ttsService.setConfig(ttsEnabled, ttsVolume, 0.95);\n  }, [ttsEnabled, ttsVolume]);\n\n  useEffect(() \u003d\u003e {\n    socket \u003d io(\u0027http://localhost:3001\u0027);\n\n    socket.on(\u0027new_gift\u0027, (gift: GiftEvent) \u003d\u003e {\n      setGiftLogs((prev) \u003d\u003e [gift, ...prev.slice(0, 49)]);\n      setActiveEffect(gift.giftName);\n\n      // Phát TTS cảm ơn\n      const giftLabel \u003d gift.giftName \u003d\u003d\u003d \u0027ROSE\u0027 ? \u0027Hoa Hồng\u0027 : gift.giftName \u003d\u003d\u003d \u0027HEART\u0027 ? \u0027Trái Tim\u0027 : \u0027Đèn Hoa Đăng\u0027;\n      ttsService.speak(`Công đức vô lượng. Phúc An Tự xin cảm tạ thí chủ ${gift.senderName} đã hoan hỷ gửi tặng ${gift.count} ${giftLabel}.`);\n\n      // Tắt hiệu ứng sau 4.5 giây\n      setTimeout(() \u003d\u003e {\n        setActiveEffect(null);\n      }, 4500);\n    });\n\n    return () \u003d\u003e {\n      socket.disconnect();\n    };\n  }, []);\n\n  const simulateGift \u003d (giftName: \u0027ROSE\u0027 | \u0027HEART\u0027 | \u0027LOTUS\u0027 | \u0027BELL\u0027 | \u0027CANDLE\u0027, count: number) \u003d\u003e {\n    const names \u003d [\u0027Thanh Tâm\u0027, \u0027Minh Tuệ\u0027, \u0027Diệu Hoa\u0027, \u0027Nguyên An\u0027, \u0027Phúc Lâm\u0027, \u0027Tuệ Tánh\u0027];\n    const randomName \u003d names[Math.floor(Math.random() * names.length)];\n    socket?.emit(\u0027simulate_gift\u0027, {\n      senderName: randomName,\n      giftName,\n      count\n    });\n  };\n\n  const addCharacter \u003d () \u003d\u003e {\n    const newId \u003d (characters.length + 1).toString();\n    setCharacters((prev) \u003d\u003e [\n      ...prev,\n      {\n        id: newId,\n        name: `Đồng Tu ${newId}`,\n        position: [(Math.random() - 0.5) * 6, 0, (Math.random() - 0.5) * 4 - 1],\n        rotationY: 0,\n        action: \u0027PRAY_HANDS\u0027,\n        color: \u0027#718096\u0027\n      }\n    ]);\n  };\n\n  const removeCharacter \u003d (id: string) \u003d\u003e {\n    setCharacters((prev) \u003d\u003e prev.filter((c) \u003d\u003e c.id !\u003d\u003d id));\n  };\n\n  const updateCharacterAction \u003d (id: string, action: CharacterAction) \u003d\u003e {\n    setCharacters((prev) \u003d\u003e\n      prev.map((c) \u003d\u003e (c.id \u003d\u003d\u003d id ? { ...c, action } : c))\n    );\n  };\n\n  const updateCharacterPos \u003d (id: string, pos: [number, number, number]) \u003d\u003e {\n    setCharacters((prev) \u003d\u003e\n      prev.map((c) \u003d\u003e (c.id \u003d\u003d\u003d id ? { ...c, position: pos } : c))\n    );\n  };\n\n  return (\n    \u003cLiveContext.Provider\n      value\u003d{{\n        aspectRatio,\n        setAspectRatio,\n        cleanMode,\n        setCleanMode,\n        lowPerformance,\n        setLowPerformance,\n        cameraPreset,\n        setCameraPreset,\n        characters,\n        addCharacter,\n        removeCharacter,\n        updateCharacterAction,\n        updateCharacterPos,\n        giftLogs,\n        activeEffect,\n        simulateGift,\n        ttsEnabled,\n        setTtsEnabled,\n        ttsVolume,\n        setTtsVolume,\n        fps,\n        setFps,\n        tiktokConnected,\n        tiktokMessage\n      }}\n    \u003e\n      {children}\n    \u003c/LiveContext.Provider\u003e\n  );\n};\n\nexport const useLive \u003d () \u003d\u003e {\n  const ctx \u003d useContext(LiveContext);\n  if (!ctx) throw new Error(\u0027useLive must be used within LiveProvider\u0027);\n  return ctx;\n};\n```\n\n---\n\n### BƯỚC 4: THẾ GIỚI 3D CHÙA VIỆT NAM (PROCEDURAL LOW-POLY)\n\nTất cả các kiến trúc (Cổng tam quan, Chính điện mái đao cong ngói đỏ, Bàn tam bảo, Tượng Phật Thích Ca Mâu Ni thiền định trên tòa sen, Lư hương ngút khói, Đèn lồng đỏ, Cầu kiều và Hồ sen) đều được dựng bằng khối chuẩn để không phụ thuộc vào mạng hay file nặng.\n\n#### `src/components/scene/Architecture.tsx`\n```typescript\nimport React from \u0027react\u0027;\n\nexport const VietnameseTemple: React.FC \u003d () \u003d\u003e {\n  return (\n    \u003cgroup\u003e\n      {/* SÀN SÂN CHÙA GẠCH BÁT TRÀNG */}\n      \u003cmesh rotation\u003d{[-Math.PI / 2, 0, 0]} position\u003d{[0, -0.01, 0]} receiveShadow\u003e\n        \u003cplaneGeometry args\u003d{[36, 42]} /\u003e\n        \u003cmeshStandardMaterial color\u003d\"#8c4836\" roughness\u003d{0.9} /\u003e\n      \u003c/mesh\u003e\n\n      {/* TƯỜNG BAO SÂN CHÙA */}\n      \u003cmesh position\u003d{[0, 1, -18]}\u003e\n        \u003cboxGeometry args\u003d{[36, 2, 0.6]} /\u003e\n        \u003cmeshStandardMaterial color\u003d\"#d4c5a9\" /\u003e\n      \u003c/mesh\u003e\n\n      {/* --- CHÍNH ĐIỆN PHÚC AN TỰ --- */}\n      \u003cgroup position\u003d{[0, 0, -8]}\u003e\n        {/* Nền bệ đá chính điện */}\n        \u003cmesh position\u003d{[0, 0.4, 0]}\u003e\n          \u003cboxGeometry args\u003d{[14, 0.8, 10]} /\u003e\n          \u003cmeshStandardMaterial color\u003d\"#a0aec0\" roughness\u003d{0.8} /\u003e\n        \u003c/mesh\u003e\n\n        {/* Cột gỗ chính điện */}\n        {[-5.5, -2, 2, 5.5].map((x, i) \u003d\u003e (\n          \u003cReact.Fragment key\u003d{i}\u003e\n            \u003cmesh position\u003d{[x, 2.5, 3.8]}\u003e\n              \u003ccylinderGeometry args\u003d{[0.25, 0.28, 4.2, 10]} /\u003e\n              \u003cmeshStandardMaterial color\u003d\"#501a14\" roughness\u003d{0.5} /\u003e\n            \u003c/mesh\u003e\n            \